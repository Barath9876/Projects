#include <xc.h>

#pragma config FOSC = INTRC_NOCLKOUT
#pragma config WDTE = OFF
#pragma config LVP = OFF

volatile unsigned int count = 0;
unsigned char segment[10] = {0x3F, 0x06, 0x5B, 0x4F, 0x66,0x6D, 0x7D, 0x07, 0x7F, 0x6F};
void Timer1_Init()
{
    TMR1H = 0xCF;
    TMR1L = 0x2B;

    TMR1IF = 0;
    while(TMR1IF == 0);
}

void delay_cy(unsigned int cycle) {
    unsigned int count;

    for (count = 0; count < cycle; count++) {
        TMR1IF = 0;

        TMR1H = 0xCF;
        TMR1L = 0x2B;

        while (TMR1IF == 0);

        TMR1IF = 0;
    }
}





void main()
{
    ANSEL = 0x00;
    ANSELH = 0x00;

    PORTA = 0x00;
    TRISA = 0x00;
    
    PORTB = 0X00;
    TRISB=0X00;
    
    PORTC = 0X00;
    TRISC = 0X0F;
    

    TMR1H = 0xCF;
    TMR1L = 0x2C;

    T1CON = 0x31;

    TMR1IF = 0;
    TMR1IE = 1;

    PEIE = 1;
    GIE = 1;
    unsigned int i, j, b4st, b3st,rev, b1st = 0;
    unsigned char curr_value = 0;
   
    while(1)
    {
        Timer1_Init();
        count++;

        if(count == 12)      
        {
            RA0 = 1;
        }

        if(count == 21)      
        {
            RA1 = 1;
        }
        if(RC0 == 1)
        {
            b1st=1;
            
        }
        if(RC1 == 1)
         {  
            rev = 1;
            
        }
        if(b1st == 1 && rev == 0)
        {
        for(i = 0; i < 10; i++)
        {
            for(j = 0; j < 10; j++)
            {
                if(RC1 == 1)
                {
                    rev = 1;
                    goto REVERSE_MODE;   // Immediately jump
                }

                curr_value = (i * 10) + j;

                RA4 = 0;
                RA5 = 1;
                PORTB = segment[i];
                delay_cy(5);

                RA4 = 1;
                RA5 = 0;
                PORTB = segment[j];
                delay_cy(10);
            }
        }
    }

    REVERSE_MODE:

    if(rev == 1)
    {
        unsigned char tens, units;

        tens  = curr_value / 10;
        units = curr_value % 10;

        for(i = tens; ; i--)
        {   
            if(i == tens)
                j = units;
            else
                j = 9;

            for( ; ; j--)
            {   if(RC2 == 1){
                 b3st = 1;
                 goto RELAY_MODE;
                }
                
                RA4 = 0;
                RA5 = 1;
                PORTB = segment[i];
                delay_cy(5);

                RA4 = 1;
                RA5 = 0;
                PORTB = segment[j];
                delay_cy(5);

                if(j == 0)
                    break;
            }

            if(i == 0)
                break;
        }

        rev = 0;
    }
    RELAY_MODE:
    if(b3st == 1){
        count =0;
        RC5 = 1;
        RA2 = 1;
        delay_cy(80);
        RC5 = 0;
        RA2 = 0;
        RA3 = 1;
       
        }
    }
}
